@prefix ex: <http://example.org/TaskTwo#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@base <http://www.w3.org/2002/07/owl#> .

[ rdf:type owl:Ontology
 ] .

#################################################################
#    Object Properties
#################################################################

###  http://example.org/TaskTwo#hasAncestor
ex:hasAncestor rdf:type owl:ObjectProperty ,
                        owl:TransitiveProperty ;
               rdfs:domain ex:Person ;
               rdfs:range ex:Person ;
               owl:propertyChainAxiom ( ex:hasParent
                                      ) .


###  http://example.org/TaskTwo#hasChild
ex:hasChild rdf:type owl:ObjectProperty ;
            owl:inverseOf ex:hasParent ;
            rdfs:domain ex:Person ;
            rdfs:range ex:Person .


###  http://example.org/TaskTwo#hasDescendant
ex:hasDescendant rdf:type owl:ObjectProperty ,
                          owl:TransitiveProperty ;
                 rdfs:domain ex:Person ;
                 rdfs:range ex:Person ;
                 owl:propertyChainAxiom ( ex:hasChild
                                        ) .


###  http://example.org/TaskTwo#hasParent
ex:hasParent rdf:type owl:ObjectProperty ,
                      owl:FunctionalProperty ,
                      owl:IrreflexiveProperty ;
             rdfs:domain ex:Person ;
             rdfs:range ex:Person .


#################################################################
#    Classes
#################################################################

###  http://example.org/TaskTwo#Person
ex:Person rdf:type owl:Class .


#################################################################
#    Individuals
#################################################################

###  http://example.org/TaskTwo#Alice
ex:Alice rdf:type owl:NamedIndividual ,
                  ex:Person .


###  http://example.org/TaskTwo#John
ex:John rdf:type owl:NamedIndividual ,
                 ex:Person ;
        ex:hasParent ex:Mary .


###  http://example.org/TaskTwo#Mary
ex:Mary rdf:type owl:NamedIndividual ,
                 ex:Person ;
        ex:hasParent ex:Alice .


