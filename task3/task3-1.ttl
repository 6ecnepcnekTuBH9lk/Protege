@prefix : <http://example.org/retail#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix swrl: <http://www.w3.org/2003/11/swrl#> .
@prefix swrlb: <http://www.w3.org/2003/11/swrlb#> .
@base <http://example.org/retail#> .

<http://example.org/retail#> rdf:type owl:Ontology ;
                              rdfs:comment "Онтология для розничной торговли одеждой — классификация кандидатов для распродажи (clearance)." .

#################################################################
#    Object Properties
#################################################################

###  http://example.org/retail#seasonSuitable
:seasonSuitable rdf:type owl:ObjectProperty ;
                rdfs:domain :Product ;
                rdfs:range :Season ;
                rdfs:comment "Сезон, для которого товар предназначен (например, Winter, Summer)." .


#################################################################
#    Data properties
#################################################################

###  http://example.org/retail#hasDiscountRate
:hasDiscountRate rdf:type owl:DatatypeProperty ;
                 rdfs:domain :Product ;
                 rdfs:range xsd:double ;
                 rdfs:comment "Текущий процент скидки (0..100)." .


###  http://example.org/retail#hasStock
:hasStock rdf:type owl:DatatypeProperty ;
          rdfs:domain :Product ;
          rdfs:range xsd:integer ;
          rdfs:comment "Текущий остаток на складе." .


###  http://example.org/retail#monthlySales
:monthlySales rdf:type owl:DatatypeProperty ;
              rdfs:domain :Product ;
              rdfs:range xsd:integer ;
              rdfs:comment "Среднее количество продаж в месяц (скорость продаж)." .


#################################################################
#    Classes
#################################################################

###  http://example.org/retail#ClearanceCandidate
:ClearanceCandidate rdf:type owl:Class ;
                    rdfs:subClassOf :Product ;
                    rdfs:comment "Товары, помеченные как кандидаты для распродажи/clearance." .


###  http://example.org/retail#Product
:Product rdf:type owl:Class .


###  http://example.org/retail#Season
:Season rdf:type owl:Class .


#################################################################
#    Individuals
#################################################################

###  http://example.org/retail#NowSeason
:NowSeason rdf:type owl:NamedIndividual ,
                    :Season ;
           owl:sameAs :Summer ;
           rdfs:label "CurrentSeason" .


###  http://example.org/retail#Summer
:Summer rdf:type owl:NamedIndividual .


###  http://example.org/retail#Summer
:Summer rdf:type owl:NamedIndividual ,
                 :Season ;
        rdfs:label "Summer" .


###  http://example.org/retail#Winter
:Winter rdf:type owl:NamedIndividual ,
                 :Season ;
        rdfs:label "Winter" .


###  http://example.org/retail#prod123
:prod123 rdf:type owl:NamedIndividual ,
                  :Product ;
         :seasonSuitable :Winter ;
         :hasDiscountRate 0.0 ;
         :hasStock 120 ;
         :monthlySales 5 ;
         rdfs:label "Wool Coat - SKU 123" .


###  http://example.org/retail#prod456
:prod456 rdf:type owl:NamedIndividual ,
                  :Product ;
         :seasonSuitable :Winter ;
         :hasDiscountRate 0.0 ;
         :hasStock 10 ;
         :monthlySales 15 ;
         rdfs:label "Winter Hat - SKU 456" .


