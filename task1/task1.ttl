@prefix ex: <http://example.org/TaskOne#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@base <http://www.w3.org/2002/07/owl#> .

[ rdf:type owl:Ontology
 ] .

#################################################################
#    Datatypes
#################################################################

###  http://www.w3.org/2001/XMLSchema#date
xsd:date rdf:type rdfs:Datatype .


###  http://www.w3.org/2001/XMLSchema#gYear
xsd:gYear rdf:type rdfs:Datatype .


#################################################################
#    Object Properties
#################################################################

###  http://example.org/TaskOne#madeBy
ex:madeBy rdf:type owl:ObjectProperty ;
          rdfs:domain ex:Car ;
          rdfs:range ex:Manufacturer .


###  http://example.org/TaskOne#ownedBy
ex:ownedBy rdf:type owl:ObjectProperty ;
           rdfs:domain ex:Car ;
           rdfs:range ex:Person .


#################################################################
#    Data properties
#################################################################

###  http://example.org/TaskOne#birthDate
ex:birthDate rdf:type owl:DatatypeProperty ;
             rdfs:domain ex:Person ;
             rdfs:range xsd:date .


###  http://example.org/TaskOne#modelName
ex:modelName rdf:type owl:DatatypeProperty ;
             rdfs:domain ex:Car ;
             rdfs:range xsd:string .


###  http://example.org/TaskOne#productionYear
ex:productionYear rdf:type owl:DatatypeProperty ;
                  rdfs:domain ex:Car ;
                  rdfs:range xsd:gYear .


#################################################################
#    Classes
#################################################################

###  http://example.org/TaskOne#Car
ex:Car rdf:type owl:Class .


###  http://example.org/TaskOne#Manufacturer
ex:Manufacturer rdf:type owl:Class .


###  http://example.org/TaskOne#Person
ex:Person rdf:type owl:Class .


#################################################################
#    Individuals
#################################################################

###  http://example.org/TaskOne#Camry2020
ex:Camry2020 rdf:type owl:NamedIndividual ,
                      ex:Car ;
             ex:madeBy ex:Toyota ;
             ex:ownedBy ex:John ;
             ex:modelName "Camry" ;
             ex:productionYear "2020"^^xsd:gYear .


###  http://example.org/TaskOne#Ford
ex:Ford rdf:type owl:NamedIndividual ,
                 ex:Manufacturer .


###  http://example.org/TaskOne#John
ex:John rdf:type owl:NamedIndividual ,
                 ex:Person ;
        ex:birthDate "1985-03-20"^^xsd:date .


###  http://example.org/TaskOne#Mary
ex:Mary rdf:type owl:NamedIndividual ,
                 ex:Person ;
        ex:birthDate "1990-07-12"^^xsd:date .


###  http://example.org/TaskOne#Mustang2018
ex:Mustang2018 rdf:type owl:NamedIndividual ,
                        ex:Car ;
               ex:madeBy ex:Ford ;
               ex:ownedBy ex:Mary ;
               ex:modelName "Mustang" ;
               ex:productionYear "2018"^^xsd:gYear .


###  http://example.org/TaskOne#Toyota
ex:Toyota rdf:type owl:NamedIndividual ,
                   ex:Manufacturer .


